  "components": {
    "schemas": {
      "Body_upload_api_v1_sessions_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_v1_sessions_post"
      },
      "Calibration": {
        "properties": {
          "corners_px": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Corners Px"
          }
        },
        "type": "object",
        "required": [
          "corners_px"
        ],
        "title": "Calibration"
      },
      "CameraBatch": {
        "properties": {
          "sequence": {
            "type": "integer",
            "maximum": 1800.0,
            "minimum": 0.0,
            "title": "Sequence"
          },
          "frames": {
            "items": {
              "$ref": "#/components/schemas/CameraFrame"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Frames"
          }
        },
        "type": "object",
        "required": [
          "sequence",
          "frames"
        ],
        "title": "CameraBatch"
      },
      "CameraFrame": {
        "properties": {
          "t_s": {
            "type": "number",
            "maximum": 60.0,
            "minimum": 0.0,
            "title": "T S"
          },
          "jpeg_base64": {
            "type": "string",
            "maxLength": 550000,
            "minLength": 20,
            "title": "Jpeg Base64"
          }
        },
        "type": "object",
        "required": [
          "t_s",
          "jpeg_base64"
        ],
        "title": "CameraFrame"
      },
      "Correction": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "rejected",
              "manual"
            ],
            "title": "Status"
          },
          "t_s": {
            "type": "number",
            "minimum": 0.0,
            "title": "T S"
          },
          "xy_px": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Xy Px"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000,
            "title": "Notes",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "status",
          "t_s",
          "xy_px"
        ],
        "title": "Correction"
      },
      "Event": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "t_s": {
            "type": "number",
            "title": "T S"
          },
          "frame": {
            "type": "integer",
            "title": "Frame"
          },
          "xy_px": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Xy Px"
          },
          "evidence_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Score"
          },
          "score_semantics": {
            "type": "string",
            "title": "Score Semantics",
            "default": "heuristic temporal-evidence score; not probability"
          },
          "status": {
            "type": "string",
            "enum": [
              "candidate",
              "confirmed",
              "rejected",
              "manual"
            ],
            "title": "Status",
            "default": "candidate"
          },
          "classification": {
            "type": "string",
            "enum": [
              "estimated_in",
              "estimated_out",
              "uncertain"
            ],
            "title": "Classification",
            "default": "uncertain"
          },
          "court_m": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Court M"
