  "components": {
    "schemas": {
      "Body_upload_api_v1_sessions_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_v1_sessions_post"
      },
      "Calibration": {
        "properties": {
          "corners_px": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Corners Px"
          }
        },
        "type": "object",
        "required": [
          "corners_px"
        ],
        "title": "Calibration"
      },
      "Correction": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "rejected",
              "manual"
            ],
            "title": "Status"
          },
          "t_s": {
            "type": "number",
            "minimum": 0.0,
            "title": "T S"
          },
          "xy_px": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Xy Px"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000,
            "title": "Notes",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "status",
          "t_s",
          "xy_px"
        ],
        "title": "Correction"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Submission": {
        "properties": {
          "calibration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Calibration"
              },
              {
                "type": "null"
              }
            ]
          },
          "preset": {
            "type": "string",
            "const": "cpu-baseline",
            "title": "Preset",
            "default": "cpu-baseline"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Idempotency Key"
          }
        },
        "type": "object",
        "required": [
          "idempotency_key"
        ],
        "title": "Submission"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
